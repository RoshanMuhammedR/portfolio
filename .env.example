# The site runs with none of these set: Craft and Writings simply show their
# empty states, Home and Works use content/projects.ts, and the studio refuses
# to sign in. Fill them in to turn the backend on. See docs/BACKEND.md for
# where each value comes from.

# ---- Supabase (content) ----
# Project Settings -> Data API. The anon key is public by design; row-level
# security is what protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Filebase (optional) ----
# Studio uploads go to Supabase Storage (supabase/migrations/0006). These are
# only for /api/uploads, the older Filebase route, and it answers 501 until all
# four are set. Access Keys in the Filebase console. SERVER ONLY - never
# prefixed NEXT_PUBLIC.
FILEBASE_ACCESS_KEY=
FILEBASE_SECRET_KEY=
FILEBASE_BUCKET=
# The bucket's public gateway, e.g. https://<subdomain>.myfilebase.com
FILEBASE_PUBLIC_URL=

# ---- Studio ----
# The one address allowed to sign in and edit. Must match the email in
# supabase/schema.sql (public.is_site_owner).
OWNER_EMAIL=roshanmuhammed50@gmail.com

# ---- Contact form (optional) ----
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
