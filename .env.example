# Contact form (app/api/contact/route.ts). Copy to .env.local and fill in.

# https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that contact-form messages are delivered to
CONTACT_TO_EMAIL=

# Optional. Must be a domain verified in Resend; falls back to Resend's
# onboarding sender when unset.
CONTACT_FROM_EMAIL=
